{
  "name": "base-project",
  "version": "1.0.0",
  "description": "Boilerplate reutilizable de API REST con Node.js, Express, PostgreSQL y Redis: autenticación JWT + sesiones, RBAC, MFA, auditoría, doble aprobación (maker-checker) y notificaciones.",
  "main": "servers/monolith.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "comment": "========== MODO MONOLITO (Cliente + Admin) ==========",
    "dev": "nodemon servers/monolith.js",
    "start": "node servers/monolith.js",
    "comment2": "========== MODO CLIENTE (Solo Cliente) ==========",
    "dev:client": "nodemon servers/client.js",
    "start:client": "node servers/client.js",
    "comment3": "========== MODO ADMIN (Solo Admin) ==========",
    "dev:admin": "nodemon servers/admin.js",
    "start:admin": "node servers/admin.js",
    "comment4": "========== TESTING ==========",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:unit": "cross-env NODE_ENV=test jest --passWithNoTests --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test jest --passWithNoTests --selectProjects integration",
    "test:watch": "cross-env NODE_ENV=test jest --passWithNoTests --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --passWithNoTests --coverage",
    "comment5": "========== DATABASE ==========",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "node scripts/db-reset.js",
    "db:fresh": "npm run db:reset",
    "comment6": "========== LINTING & FORMAT ==========",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "nodemonConfig": {
    "watch": [
      "servers",
      "modules",
      "shared",
      "config"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "tests",
      "*.test.js"
    ],
    "delay": 1000
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spudy101/base-project.git"
  },
  "author": "spudy101",
  "license": "MIT",
  "homepage": "https://github.com/spudy101/base-project#readme",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1007.0",
    "@aws-sdk/client-ses": "^3.1007.0",
    "@aws-sdk/client-sns": "^3.1007.0",
    "@aws-sdk/s3-request-presigner": "^3.1007.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.2",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "otplib": "12.0.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-filenames-simple": "^0.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.2",
    "sequelize-cli": "^6.6.3",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "js-cookie": "^3.0.7",
    "tmp": "^0.2.7"
  }
}
