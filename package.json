{
  "name": "base-project",
  "version": "1.0.0",
  "description": "Boilerplate reutilizable de API REST con Node.js, Express, PostgreSQL y Redis: autenticación JWT + sesiones, RBAC, MFA, auditoría, doble aprobación (maker-checker) y notificaciones.",
  "main": "dist/servers/monolith.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "comment": "========== MODO MONOLITO (Cliente + Admin) ==========",
    "predev": "npm run prisma:generate --silent",
    "dev": "nodemon servers/monolith.ts",
    "start": "node dist/servers/monolith.js",
    "comment2": "========== MODO CLIENTE (Solo Cliente) ==========",
    "predev:client": "npm run prisma:generate --silent",
    "dev:client": "nodemon servers/client.ts",
    "start:client": "node dist/servers/client.js",
    "comment3": "========== MODO ADMIN (Solo Admin) ==========",
    "predev:admin": "npm run prisma:generate --silent",
    "dev:admin": "nodemon servers/admin.ts",
    "start:admin": "node dist/servers/admin.js",
    "comment_build": "========== TYPESCRIPT ==========",
    "prebuild": "npm run prisma:generate --silent",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run prisma:generate --silent",
    "typecheck": "tsc -p tsconfig.test.json",
    "comment4": "========== TESTING ==========",
    "pretest": "npm run prisma:generate --silent",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:unit": "cross-env NODE_ENV=test jest --passWithNoTests --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test jest --passWithNoTests --selectProjects integration",
    "test:watch": "cross-env NODE_ENV=test jest --passWithNoTests --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --passWithNoTests --coverage",
    "comment5": "========== DATABASE ==========",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:fresh": "npm run db:reset",
    "db:test:prepare": "tsx scripts/db-test-prepare.ts",
    "keys:generate": "tsx scripts/generate-keys.util.ts",
    "comment_prisma": "========== PRISMA (docs/prisma-migration.md) ==========",
    "prisma:generate": "prisma generate && tsx scripts/gen-prisma-metadata.ts",
    "prisma:pull": "prisma db pull",
    "prisma:studio": "prisma studio",
    "check:orm": "node scripts/prisma-migration/find-live-instances.js",
    "comment6": "========== LINTING & FORMAT ==========",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "nodemonConfig": {
    "watch": [
      "servers",
      "modules",
      "shared",
      "config"
    ],
    "ext": "ts,json",
    "ignore": [
      "node_modules",
      "dist",
      "tests",
      "*.test.ts"
    ],
    "delay": 1000,
    "execMap": {
      "ts": "tsx"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spudy101/base-project.git"
  },
  "author": "spudy101",
  "license": "MIT",
  "homepage": "https://github.com/spudy101/base-project#readme",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1007.0",
    "@aws-sdk/client-ses": "^3.1007.0",
    "@aws-sdk/client-sns": "^3.1007.0",
    "@aws-sdk/s3-request-presigner": "^3.1007.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.2",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "otplib": "12.0.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-filenames-simple": "^0.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.2",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "js-cookie": "^3.0.7",
    "tmp": "^0.2.7"
  }
}
