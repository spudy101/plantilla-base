}

model BiometricChallenge {
  challengeId String   @id @default(uuid()) @map("challenge_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  challenge   String   @unique
  type        String   @db.VarChar(20)
  used        Boolean  @default(false)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([expiresAt], map: "idx_biometric_challenges_expires_at")
  @@index([userId], map: "idx_biometric_challenges_user_id")
  @@map("biometric_challenges")
}

model City {
  cityId          String           @id @default(uuid()) @map("city_id") @db.Uuid
  name            String           @db.VarChar(100)
  daneCode        String?          @map("dane_code") @db.VarChar(3)
  departmentId    String           @map("department_id") @db.Uuid
  isActive        Boolean?         @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  department      Department       @relation(fields: [departmentId], references: [departmentId])
  personLocations PersonLocation[]

  @@index([departmentId], map: "cities_department_id")
  @@index([departmentId, name], map: "cities_department_id_name")
  @@index([isActive], map: "cities_is_active")
  @@index([name], map: "cities_name")
  @@map("cities")
}

model ConsentType {
  consentTypeId String        @id @default(uuid()) @map("consent_type_id") @db.Uuid
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(200)
  description   String?
  isMandatory   Boolean       @default(true) @map("is_mandatory")
  isRevocable   Boolean       @default(false) @map("is_revocable")
  isActive      Boolean       @default(true) @map("is_active")
  scope         String        @default("ONBOARDING") @db.VarChar(20)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  userConsents  UserConsent[]

  @@index([code])
  @@index([isActive])
