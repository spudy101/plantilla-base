model UserPushToken {
  userPushTokenId     String    @id @default(uuid()) @map("user_push_token_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  token               String
  platform            String    @db.VarChar(20)
  deviceId            String?   @map("device_id") @db.VarChar(255)
  isActive            Boolean?  @default(true) @map("is_active")
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)
  originSessionId     String?   @map("origin_session_id") @db.Uuid
  originCorrelationId String?   @map("origin_correlation_id") @db.VarChar(128)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, token], map: "user_push_tokens_user_id_token")
  @@index([originSessionId], map: "idx_user_push_tokens_origin_session_id")
  @@index([isActive], map: "user_push_tokens_is_active")
  @@index([platform], map: "user_push_tokens_platform")
  @@index([userId], map: "user_push_tokens_user_id")
  @@index([userId, isActive], map: "user_push_tokens_user_id_is_active")
  @@map("user_push_tokens")
}

model UserSession {
  userSessionId String             @id @default(dbgenerated("gen_random_uuid()")) @map("user_session_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  deviceId      String?            @map("device_id") @db.Uuid
  jti           String             @unique @db.VarChar(36)
  ipAddress     String?            @map("ip_address") @db.VarChar(45)
  userAgent     String?            @map("user_agent")
  status        UserSessionStatus  @default(active)
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  lastAccessAt  DateTime           @default(now()) @map("last_access_at") @db.Timestamptz(6)
  closedAt      DateTime?          @map("closed_at") @db.Timestamptz(6)
  closeReason   String?            @map("close_reason") @db.VarChar(50)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  device        UserTrustedDevice? @relation(fields: [deviceId], references: [userTrustedDeviceId])

  @@index([userId, status], map: "public_user_sessions_user_id_status")
  @@index([deviceId], map: "user_sessions_device_id")
  @@index([startedAt], map: "user_sessions_started_at")
  @@index([status], map: "user_sessions_status")
  @@index([userId], map: "user_sessions_user_id")
  @@map("user_sessions")
}

model UserTrustedDevice {
  userTrustedDeviceId                  String                    @id @default(uuid()) @map("user_trusted_device_id") @db.Uuid
  userId                               String                    @map("user_id") @db.Uuid
  fingerprintHash                      String                    @map("fingerprint_hash") @db.VarChar(64)
  deviceName                           String                    @map("device_name") @db.VarChar(100)
  status                               String                    @default("pending") @db.VarChar(20)
  ipAddress                            String?                   @map("ip_address") @db.VarChar(45)
  city                                 String?                   @db.VarChar(100)
  country                              String?                   @db.VarChar(100)
  countryCode                          String?                   @map("country_code") @db.VarChar(5)
  browser                              String?                   @db.VarChar(100)
  os                                   String?                   @db.VarChar(100)
  deviceType                           String                    @default("desktop") @map("device_type") @db.VarChar(20)
  hmacSecret                           String?                   @map("hmac_secret") @db.VarChar(200)
  approvedByDeviceId                   String?                   @map("approved_by_device_id") @db.Uuid
  approvedAt                           DateTime?                 @map("approved_at") @db.Timestamptz(6)
  blockedByDeviceId                    String?                   @map("blocked_by_device_id") @db.Uuid
  blockedAt                            DateTime?                 @map("blocked_at") @db.Timestamptz(6)
  trustedAt                            DateTime?                 @map("trusted_at") @db.Timestamptz(6)
  lastSeenAt                           DateTime                  @map("last_seen_at") @db.Timestamptz(6)
  originSessionId                      String?                   @map("origin_session_id") @db.Uuid
  originCorrelationId                  String?                   @map("origin_correlation_id") @db.VarChar(128)
  createdAt                            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  userBiometricCredentials             UserBiometricCredential[]
  sessions                             UserSession[]
  approvedByDevice                     UserTrustedDevice?        @relation("UserTrustedDevice_approvedByDevice", fields: [approvedByDeviceId], references: [userTrustedDeviceId], onUpdate: SetNull)
  userTrustedDevicesByApprovedByDevice UserTrustedDevice[]       @relation("UserTrustedDevice_approvedByDevice")
  blockedByDevice                      UserTrustedDevice?        @relation("UserTrustedDevice_blockedByDevice", fields: [blockedByDeviceId], references: [userTrustedDeviceId], onUpdate: SetNull)
  userTrustedDevicesByBlockedByDevice  UserTrustedDevice[]       @relation("UserTrustedDevice_blockedByDevice")
  user                                 User                      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, fingerprintHash], map: "uq_user_trusted_devices_user_fingerprint")
  @@index([fingerprintHash], map: "idx_user_trusted_devices_fingerprint_hash")
  @@index([lastSeenAt], map: "idx_user_trusted_devices_last_seen_at")
  @@index([originSessionId], map: "idx_user_trusted_devices_origin_session_id")
  @@index([userId], map: "idx_user_trusted_devices_user_id")
  @@index([userId, status], map: "idx_user_trusted_devices_user_status")
  @@map("user_trusted_devices")
}

model User {
  userId                           String                       @id @default(uuid()) @map("user_id") @db.Uuid
  username                         String                       @unique @db.VarChar(50)
  passwordHash                     String?                      @map("password_hash") @db.VarChar(255)
  authUsername                     String?                      @unique(map: "users_cognito_username_key") @map("auth_username") @db.VarChar(255)
  personId                         String                       @unique @map("person_id") @db.Uuid
  roleId                           String                       @map("role_id") @db.Uuid
  avatarId                         String?                      @map("avatar_id") @db.Uuid
  totpEnabled                      Boolean?                     @default(false) @map("totp_enabled")
  smsMfaEnabled                    Boolean                      @default(false) @map("sms_mfa_enabled")
  preferredMfaMethod               String                       @default("none") @map("preferred_mfa_method") @db.VarChar(10)
  privacyPolicyVersion             String?                      @map("privacy_policy_version") @db.VarChar(20)
  privacyPolicyAcceptedAt          DateTime?                    @map("privacy_policy_accepted_at") @db.Timestamptz(6)
  privacyPolicyAcceptedIp          String?                      @map("privacy_policy_accepted_ip") @db.VarChar(45)
  isActive                         Boolean?                     @default(true) @map("is_active")
  createdAt                        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  // columna "deletedAt" fuera del schema: residuo sin uso (la real es deleted_at); fase 6c la elimina
  deletedAt                        DateTime?                    @map("deleted_at") @db.Timestamptz(6)
  totpSecret                       String?                      @map("totp_secret")
  approvalRequestsByRequestedBy    ApprovalRequest[]            @relation("ApprovalRequest_requester")
  approvalRequestsBySecondApprover ApprovalRequest[]            @relation("ApprovalRequest_secondApprover")
  biometricChallenges              BiometricChallenge[]
  emailBounceSuppressions          EmailBounceSuppression[]
  globalNotificationReads          GlobalNotificationRead[]
  globalNotifications              GlobalNotification[]
  notifications                    Notification[]
  resetCredentials                 ResetCredentials[]
  rolePermissionOverrides          RolePermissionOverride[]
  smsDeliveryAttempts              SmsDeliveryAttempt[]
  userBiometricCredentials         UserBiometricCredential[]
  userChangeLogsByChangedByUser    UserChangeLog[]              @relation("UserChangeLog_changedBy")
  userChangeLogsByUser             UserChangeLog[]              @relation("UserChangeLog_user")
  userConsents                     UserConsent[]
  loginAttempts                    UserLoginAttempt[]
  notificationPreference           UserNotificationPreference[]
  userPushTokens                   UserPushToken[]
  trustedDevices                   UserTrustedDevice[]
  avatar                           Avatar?                      @relation(fields: [avatarId], references: [avatarId])
  person                           Person                       @relation(fields: [personId], references: [personId], onDelete: Cascade)
  role                             Role                         @relation(fields: [roleId], references: [roleId])

  @@index([deletedAt], map: "idx_users_deleted_at")
  @@index([smsMfaEnabled], map: "idx_users_sms_mfa_enabled")
  @@index([isActive], map: "users_is_active")
  @@index([personId], map: "users_person_id")
  @@index([privacyPolicyVersion])
  @@index([roleId], map: "users_role_id")
  @@index([username], map: "users_username")
  @@map("users")
}

model VerificationCode {
  verificationCodeId  String               @id @default(uuid()) @map("verification_code_id") @db.Uuid
  type                VerificationCodeType
  contactValue        String               @map("contact_value") @db.VarChar(255)
  code                String               @db.VarChar(10)
  attempts            Int?                 @default(0)
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz(6)
  verifiedAt          DateTime?            @map("verified_at") @db.Timestamptz(6)
  originSessionId     String?              @map("origin_session_id") @db.Uuid
  originCorrelationId String?              @map("origin_correlation_id") @db.VarChar(128)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([originSessionId], map: "idx_verification_codes_origin_session_id")
  @@index([contactValue], map: "verification_codes_contact_value")
  @@index([contactValue, type, expiresAt], map: "verification_codes_contact_value_type_expires_at")
  @@index([expiresAt], map: "verification_codes_expires_at")
  @@index([type], map: "verification_codes_type")
  @@index([verifiedAt], map: "verification_codes_verified_at")
  @@map("verification_codes")
}

