generator client {
  provider        = "prisma-client"
  output          = "../shared/database/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model SequelizeData {
  name String @id @db.VarChar(255)

  @@ignore
}

model SequelizeMeta {
  name String @id @db.VarChar(255)

  @@ignore
}

model ApprovalRequest {
  approvalRequestId   String                @id @default(dbgenerated("gen_random_uuid()")) @map("approval_request_id") @db.Uuid
  operationKey        String                @map("operation_key") @db.VarChar(100)
  entityType          String?               @map("entity_type") @db.VarChar(100)
  entityId            String?               @map("entity_id") @db.Uuid
  payload             Json                  @default("{}")
  requestedBy         String                @map("requested_by") @db.Uuid
  requestedAt         DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  status              ApprovalRequestStatus @default(pending)
  secondApproverId    String?               @map("second_approver_id") @db.Uuid
  resolvedAt          DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes     String?               @map("resolution_notes")
  expiresAt           DateTime?             @map("expires_at") @db.Timestamptz(6)
  result              Json?
  originSessionId     String?               @map("origin_session_id") @db.Uuid
  originCorrelationId String?               @map("origin_correlation_id") @db.VarChar(128)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requester           User                  @relation("ApprovalRequest_requester", fields: [requestedBy], references: [userId])
  secondApprover      User?                 @relation("ApprovalRequest_secondApprover", fields: [secondApproverId], references: [userId])

  @@unique([entityType, entityId, operationKey], map: "uq_approval_requests_pending_entity_op", where: raw("(status = 'pending'::enum_approval_requests_status)"))
  @@index([entityType, entityId], map: "idx_approval_requests_entity")
  @@index([expiresAt], map: "idx_approval_requests_expires_at")
  @@index([operationKey], map: "idx_approval_requests_operation_key")
  @@index([originSessionId], map: "idx_approval_requests_origin_session_id")
  @@index([requestedBy], map: "idx_approval_requests_requested_by")
  @@index([status], map: "idx_approval_requests_status")
  @@map("approval_requests")
}

model AuditAlert {
  alertId        String         @id @default(uuid()) @map("alert_id") @db.Uuid
  auditLogId     String?        @map("audit_log_id") @db.Uuid
  action         String         @db.VarChar(100)
  category       String?        @db.VarChar(50)
  risk           AuditAlertRisk @default(high)
  userId         String?        @map("user_id") @db.Uuid
  entityId       String?        @map("entity_id") @db.VarChar(255)
  entityType     String?        @map("entity_type") @db.VarChar(100)
  message        String?
  acknowledged   Boolean        @default(false)
  acknowledgedBy String?        @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?      @map("acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action], map: "audit_alerts_action")
  @@index([createdAt], map: "audit_alerts_created_at")
  @@index([userId], map: "audit_alerts_user_id")
  @@index([acknowledged, createdAt], map: "idx_audit_alerts_pending")
  @@map("audit_alerts")
}

model AuditLog {
  auditLogId    String          @id @default(uuid()) @map("audit_log_id") @db.Uuid
  action        String          @db.VarChar(100)
  description   String?         @db.VarChar(255)
  category      String?         @db.VarChar(50)
  risk          AuditLogRisk    @default(unknown)
  outcome       AuditLogOutcome @default(success)
  httpStatus    Int?            @map("http_status") @db.SmallInt
  errorCode     String?         @map("error_code") @db.VarChar(100)
  errorMessage  String?         @map("error_message")
  userId        String?         @map("user_id") @db.Uuid
  correlationId String?         @map("correlation_id") @db.VarChar(100)
  ip            String?         @db.VarChar(45)
  userAgent     String?         @map("user_agent")
  fingerprint   String?         @db.VarChar(64)
  method        String?         @db.VarChar(10)
  path          String?
  details       Json?
  source        String          @default("http") @db.VarChar(50)
  entityId      String?         @map("entity_id") @db.VarChar(255)
  entityType    String?         @map("entity_type") @db.VarChar(100)
  entityTable   String?         @map("entity_table") @db.VarChar(150)
  module        String?         @db.VarChar(50)
  sessionId     String?         @map("session_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([action], map: "audit_logs_action")
  @@index([category], map: "audit_logs_category")
  @@index([correlationId], map: "audit_logs_correlation_id")
  @@index([createdAt], map: "audit_logs_created_at")
  @@index([ip], map: "audit_logs_ip")
  @@index([risk], map: "audit_logs_risk")
  @@index([source], map: "audit_logs_source")
  @@index([userId], map: "audit_logs_user_id")
  @@index([category, risk, createdAt], map: "idx_audit_logs_category_risk_date")
  @@index([entityId], map: "idx_audit_logs_entity_id")
  @@index([entityTable], map: "idx_audit_logs_entity_table")
  @@index([module], map: "idx_audit_logs_module")
  @@index([outcome], map: "idx_audit_logs_outcome")
  @@index([outcome, createdAt], map: "idx_audit_logs_outcome_date")
  @@index([sessionId, createdAt], map: "idx_audit_logs_session_date")
  @@index([sessionId], map: "idx_audit_logs_session_id")
  @@index([userId, createdAt], map: "idx_audit_logs_user_date")
  @@map("audit_logs")
}

model AvatarTheme {
  avatarThemeId String   @id @default(uuid()) @map("avatar_theme_id") @db.Uuid
  name          String   @unique @db.VarChar(100)
  isActive      Boolean? @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  avatars       Avatar[]

  @@index([isActive], map: "avatar_themes_is_active")
  @@map("avatar_themes")
}

model Avatar {
  avatarId      String      @id @default(uuid()) @map("avatar_id") @db.Uuid
  name          String      @db.VarChar(100)
  avatarThemeId String      @map("avatar_theme_id") @db.Uuid
  imageUrl      String?     @map("image_url") @db.VarChar(255)
  isActive      Boolean?    @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
