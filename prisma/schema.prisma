}

model GlobalNotificationRead {
  globalNotificationId String             @map("global_notification_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  readAt               DateTime?          @map("read_at") @db.Timestamptz(6)
  originSessionId      String?            @map("origin_session_id") @db.Uuid
  originCorrelationId  String?            @map("origin_correlation_id") @db.VarChar(128)
  globalNotification   GlobalNotification @relation(fields: [globalNotificationId], references: [globalNotificationId], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([globalNotificationId, userId])
  @@index([globalNotificationId], map: "global_notification_reads_global_notification_id")
  @@index([readAt], map: "global_notification_reads_read_at")
  @@index([userId], map: "global_notification_reads_user_id")
  @@index([originSessionId], map: "idx_global_notification_reads_origin_session_id")
  @@map("global_notification_reads")
}

model GlobalNotification {
  globalNotificationId    String                   @id @default(uuid()) @map("global_notification_id") @db.Uuid
  notificationTypeId      String?                  @map("notification_type_id") @db.Uuid
  title                   String
  body                    String
  metadata                Json?
  sendPush                Boolean?                 @default(false) @map("send_push")
  sendEmail               Boolean?                 @default(false) @map("send_email")
  sendInApp               Boolean?                 @default(true) @map("send_in_app")
  pushProcessingStatus    String?                  @default("pending") @map("push_processing_status") @db.VarChar(20)
  emailProcessingStatus   String?                  @default("pending") @map("email_processing_status") @db.VarChar(20)
  pushSentCount           Int?                     @default(0) @map("push_sent_count")
  emailSentCount          Int?                     @default(0) @map("email_sent_count")
  isActive                Boolean?                 @default(true) @map("is_active")
  startsAt                DateTime?                @map("starts_at") @db.Timestamptz(6)
  endsAt                  DateTime?                @map("ends_at") @db.Timestamptz(6)
  targetUserRole          String?                  @map("target_user_role") @db.VarChar(50)
  targetConditions        Json?                    @map("target_conditions")
  createdBy               String?                  @map("created_by") @db.Uuid
  batchSize               Int?                     @default(100) @map("batch_size")
  processingStartedAt     DateTime?                @map("processing_started_at") @db.Timestamptz(6)
  processingCompletedAt   DateTime?                @map("processing_completed_at") @db.Timestamptz(6)
  totalTargetUsers        Int?                     @default(0) @map("total_target_users")
  originSessionId         String?                  @map("origin_session_id") @db.Uuid
  originCorrelationId     String?                  @map("origin_correlation_id") @db.VarChar(128)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  globalNotificationReads GlobalNotificationRead[]
  creator                 User?                    @relation(fields: [createdBy], references: [userId])
  notificationType        NotificationType?        @relation(fields: [notificationTypeId], references: [notificationTypeId])

  @@index([createdBy], map: "global_notifications_created_by")
  @@index([emailProcessingStatus], map: "global_notifications_email_processing_status")
  @@index([isActive, startsAt, endsAt], map: "global_notifications_is_active_starts_at_ends_at")
  @@index([notificationTypeId], map: "global_notifications_notification_type_id")
  @@index([pushProcessingStatus], map: "global_notifications_push_processing_status")
  @@index([originSessionId], map: "idx_global_notifications_origin_session_id")
  @@map("global_notifications")
}

model IntegrationApiLog {
  apiLogId        String                   @id @default(uuid()) @map("api_log_id") @db.Uuid
  product         IntegrationApiLogProduct
  endpoint        String                   @db.VarChar(500)
  userId          String?                  @map("user_id") @db.Uuid
  sessionId       String?                  @map("session_id") @db.Uuid
  result          IntegrationApiLogResult
  responseTimeMs  Int?                     @map("response_time_ms")
  errorCode       String?                  @map("error_code") @db.VarChar(50)
  errorMessage    String?                  @map("error_message")
  requestPayload  Json?                    @map("request_payload")
  responsePayload Json?                    @map("response_payload")
  isSystemError   Boolean                  @default(false) @map("is_system_error")
  notificationId  String?                  @map("notification_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "integration_api_logs_created_at")
  @@index([notificationId], map: "integration_api_logs_notification_id")
  @@index([product], map: "integration_api_logs_product")
  @@index([product, result, createdAt], map: "integration_api_logs_product_result_created_at")
  @@index([result], map: "integration_api_logs_result")
  @@index([sessionId], map: "integration_api_logs_session_id")
  @@index([userId], map: "integration_api_logs_user_id")
  @@map("integration_api_logs")
}

model NotificationCategory {
  notificationCategoryId String                       @id @default(uuid()) @map("notification_category_id") @db.Uuid
  code                   String                       @unique(map: "idx_notification_categories_code") @db.VarChar(100)
  name                   String                       @db.VarChar(200)
  description            String?
  supportsPush           Boolean                      @default(true) @map("supports_push")
  supportsEmail          Boolean                      @default(true) @map("supports_email")
  supportsSms            Boolean                      @default(false) @map("supports_sms")
  allowDnd               Boolean                      @default(true) @map("allow_dnd")
  isCritical             Boolean                      @default(false) @map("is_critical")
  defaultQuietHoursStart DateTime?                    @map("default_quiet_hours_start") @db.Time(6)
  defaultQuietHoursEnd   DateTime?                    @map("default_quiet_hours_end") @db.Time(6)
  priority               String                       @default("normal") @db.VarChar(20)
  emailLayoutTemplate    String?                      @map("email_layout_template")
  sortOrder              Int                          @default(0) @map("sort_order")
  isActive               Boolean                      @default(true) @map("is_active")
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  notificationTypes      NotificationType[]
  userPreferences        UserNotificationPreference[]

  @@index([isActive], map: "idx_notification_categories_is_active")
  @@map("notification_categories")
}

model NotificationType {
  notificationTypeId     String                @id @default(uuid()) @map("notification_type_id") @db.Uuid
  code                   String                @unique(map: "notification_types_code") @db.VarChar(100)
  name                   String                @db.VarChar(200)
  description            String?
  priority               String?               @default("normal") @db.VarChar(20)
  titleTemplate          String                @map("title_template")
  bodyTemplate           String                @map("body_template")
  emailSubjectTemplate   String?               @map("email_subject_template")
  emailBodyTemplate      String?               @map("email_body_template")
  isActive               Boolean?              @default(true) @map("is_active")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  notificationCategoryId String?               @map("notification_category_id") @db.Uuid
  globalNotifications    GlobalNotification[]
  category               NotificationCategory? @relation(fields: [notificationCategoryId], references: [notificationCategoryId])
  notifications          Notification[]

  @@index([notificationCategoryId], map: "idx_notification_types_category_id")
  @@index([isActive], map: "notification_types_is_active")
  @@index([priority], map: "notification_types_priority")
  @@map("notification_types")
}

model Notification {
  notificationId     String            @id @default(uuid()) @map("notification_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  notificationTypeId String?           @map("notification_type_id") @db.Uuid
  title              String
  body               String
  relatedEntityType  String?           @map("related_entity_type") @db.VarChar(50)
  relatedEntityId    String?           @map("related_entity_id") @db.Uuid
  metadata           Json?
  isRead             Boolean?          @default(false) @map("is_read")
  readAt             DateTime?         @map("read_at") @db.Timestamptz(6)
  pushSent           Boolean?          @default(false) @map("push_sent")
  pushSentAt         DateTime?         @map("push_sent_at") @db.Timestamptz(6)
  pushError          String?           @map("push_error")
  pushRetryCount     Int?              @default(0) @map("push_retry_count")
  pushNextRetryAt    DateTime?         @map("push_next_retry_at") @db.Timestamptz(6)
  emailSent          Boolean?          @default(false) @map("email_sent")
  emailSentAt        DateTime?         @map("email_sent_at") @db.Timestamptz(6)
  emailError         String?           @map("email_error")
  emailRetryCount    Int?              @default(0) @map("email_retry_count")
  emailNextRetryAt   DateTime?         @map("email_next_retry_at") @db.Timestamptz(6)
  scheduledFor       DateTime?         @map("scheduled_for") @db.Timestamptz(6)
  priority           Int?              @default(5)
  processingStatus   String?           @default("pending") @map("processing_status") @db.VarChar(20)
  retryCount         Int               @default(0) @map("retry_count")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  smsSent            Boolean?          @default(false) @map("sms_sent")
  smsSentAt          DateTime?         @map("sms_sent_at") @db.Timestamptz(6)
  smsError           String?           @map("sms_error")
  smsRetryCount      Int?              @default(0) @map("sms_retry_count")
  smsNextRetryAt     DateTime?         @map("sms_next_retry_at") @db.Timestamptz(6)
  notificationType   NotificationType? @relation(fields: [notificationTypeId], references: [notificationTypeId])
  user               User              @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([emailNextRetryAt], map: "notifications_email_next_retry_at")
  @@index([notificationTypeId], map: "notifications_notification_type_id")
  @@index([pushNextRetryAt], map: "notifications_push_next_retry_at")
  @@index([relatedEntityType, relatedEntityId], map: "notifications_related_entity_type_related_entity_id")
  @@index([userId], map: "notifications_user_id")
  @@index([userId, createdAt], map: "notifications_user_id_created_at")
  @@index([userId, isRead, createdAt], map: "notifications_user_id_is_read_created_at")
  @@map("notifications")
