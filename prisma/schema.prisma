}

model Country {
  countryId       String           @id @default(uuid()) @map("country_id") @db.Uuid
  name            String           @unique @db.VarChar(100)
  code            String           @unique @db.VarChar(3)
  iconUrl         String?          @map("icon_url") @db.VarChar(255)
  isActive        Boolean?         @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  departments     Department[]
  personLocations PersonLocation[]
  persons         Person[]
  phonePrefixs    PhonePrefix[]

  @@index([code], map: "countries_code")
  @@index([isActive], map: "countries_is_active")
  @@map("countries")
}

model Department {
  departmentId    String           @id @default(uuid()) @map("department_id") @db.Uuid
  name            String           @db.VarChar(100)
  daneCode        String?          @map("dane_code") @db.VarChar(2)
  countryId       String           @map("country_id") @db.Uuid
  isActive        Boolean?         @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  cities          City[]
  country         Country          @relation(fields: [countryId], references: [countryId])
  personLocations PersonLocation[]

  @@index([countryId], map: "departments_country_id")
  @@index([countryId, name], map: "departments_country_id_name")
  @@index([isActive], map: "departments_is_active")
  @@index([name], map: "departments_name")
  @@map("departments")
}

model DocumentType {
  documentTypeId    String   @id @default(uuid()) @map("document_type_id") @db.Uuid
  code              String   @unique(map: "document_types_code") @db.VarChar(20)
  name              String   @db.VarChar(100)
  isVisibleToClient Boolean  @default(true) @map("is_visible_to_client")
  isActive          Boolean  @default(true) @map("is_active")
