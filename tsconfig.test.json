{
  // Typecheck de todo lo que no entra al build: tests (Jest solo transpila), migraciones, seeders y
  // scripts (corren con tsx desde las fuentes).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "shared/*": ["shared/*"],
      "modules/*": ["modules/*"],
      "config/*": ["config/*"],
      "tests/*": ["tests/*"]
    }
  },
  "include": ["servers/**/*", "modules/**/*", "shared/**/*", "config/**/*", "tests/**/*", "migrations/**/*", "seeders/**/*", "scripts/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", "scripts/ts-migration"]
}
