{
  // Typecheck de los tests .ts (Jest los transpila con Babel sin revisar tipos).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "shared/*": ["shared/*"],
      "modules/*": ["modules/*"],
      "config/*": ["config/*"],
      "tests/*": ["tests/*"]
    }
  },
  "include": ["servers/**/*", "modules/**/*", "shared/**/*", "config/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "migrations", "seeders", "scripts"]
}
