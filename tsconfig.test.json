{
  // Typecheck de todo lo que no entra al build: tests (Jest solo transpila), el seed (prisma/) y los
  // scripts (corren con tsx desde las fuentes).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "shared/*": ["shared/*"],
      "modules/*": ["modules/*"],
      "config/*": ["config/*"],
      "tests/*": ["tests/*"]
    }
  },
  "include": ["src/**/*", "modules/**/*", "shared/**/*", "config/**/*", "tests/**/*", "prisma/**/*.ts", "prisma.config.ts", "scripts/*.ts", "scripts/lib/*.ts", "scripts/prisma-migration/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", "scripts/ts-migration"]
}
