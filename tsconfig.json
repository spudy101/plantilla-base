{
  // TypeScript en modo migración gradual: los .ts conviven con los .js existentes.
  // - Los .ts se escriben en modo estricto completo.
  // - Los .js se compilan tal cual (allowJs) pero NO se revisan (checkJs: false) hasta migrarlos.
  // - Salida CommonJS: los .js que aún no se migran siguen haciendo require() de los .ts compilados.
  //   Por eso los .ts exportan con `export =` (≡ module.exports =) durante la migración.
  // Ver docs/typescript-migration.md.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node", "jest"],

    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["servers/**/*", "modules/**/*", "shared/**/*", "config/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "migrations", "seeders", "scripts", "tests"]
}
